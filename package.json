{
  "name": "steamfarm",
  "version": "0.1.0",
  "description": "Self-hosted Steam idler: playtime booster, trading card farmer and achievement manager with a web UI. No ads, no paywalls.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "binarykvparser": "^2.3.0",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
